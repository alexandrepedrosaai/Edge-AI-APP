    "        theta_vals = np.linspace(0, 2 * _PI, len(psi_vec))\n",
    "\n",
    "        # Cartesian coordinates based on amplitudes and derived angles\n",
    "        x = a * np.cos(theta_vals) * np.abs(psi_vec)\n",
    "        y = b * np.sin(theta_vals) * np.abs(psi_vec)\n",
    "        z = np.log(1 + np.abs(psi_vec)) * _PHI # Z-axis modulation by log-amplitude and Golden Ratio\n",
