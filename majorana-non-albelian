    "from scipy.optimize import minimize # Added for optimize_governance\n",
    "\n",
    "# --- UnifiedFramework and const definitions (added to resolve ModuleNotFoundError) ---\n",
    "class Const:\n",
    "    EPS = 1e-12\n",
    "    c = 299792458.0\n",
    "    m_e = 9.1093837015e-31 # Electron mass, needed for plot_orbital_trajectory\n",
    "\n",
    "const = Const()\n",
    "\n",
    "class UnifiedFramework:\n",
    "    class quantum:\n",
    "        @staticmethod\n",
    "        def majorana_state(n_dim: int) -> np.ndarray:\n",
    "            if n_dim <= 0:\n",
    "                return np.array([], dtype=complex)\n",
    "            # Placeholder implementation, adjust as per exact requirements\n",
    "            psi = np.ones(n_dim, dtype=complex)\n",
    "            return UnifiedFramework.quantum.normalize(psi)\n",
    "\n",
    "        @staticmethod\n",
    "        def normalize(psi: np.ndarray) -> np.ndarray:\n",
    "            norm_val = np.sqrt(np.vdot(psi, psi).real + const.EPS)\n",
    "            return psi / norm_val\n",
    "\n",
    "        @staticmethod\n",
    "        def density_matrix(psi: np.ndarray) -> np.ndarray:\n",
    "            return np.outer(psi, psi.conj())\n",
    "\n",
    "        @staticmethod\n",
    "        def von_neumann_entropy(rho: np.ndarray) -> float:\n",
    "            evals = np.linalg.eigh(rho)[0]\n",
    "            evals = evals[evals > const.EPS]\n",
    "            if len(evals) == 0:\n",
    "                return 0.0\n",
    "            return -np.sum(evals * np.log(evals + const.EPS))\n",
    "\n",
    "        @staticmethod\n",
    "        def hilbert_norm(psi: np.ndarray) -> float:\n",
    "            return np.sqrt(np.vdot(psi, psi).real + const.EPS)\n",
    "\n",
    "    class relativity:\n",
    "        @staticmethod\n",
    "        def gamma_factor(v: float) -> float:\n",
    "            beta = np.clip(v / const.c, -1 + const.EPS, 1 - const.EPS)\n",
    "            return 1 / np.sqrt(1 - beta**2 + const.EPS**2)\n",
    "\n",
    "    class metadata:\n",
    "        @staticmethod\n",
    "        def generate(**kwargs) -> Dict:\n",
    "            return kwargs\n",
    "\n",
    "        @staticmethod\n",
    "        def save(data: Dict, name: str):\n",
    "            with open(f\"{name}.json\", \"w\") as f:\n",
    "                json.dump(data, f, indent=2)\n",
    "\n",
    "    class ellipsoid:\n",
    "        @staticmethod\n",
    "        def volume(a: float, b: float, c: float) -> float:\n",
    "            return (4/3) * np.pi * a * b * c\n",
    "# -----------------------------------------------------------------------------\n",
    "\n",
    "# --- AgileGovernance, map_governance_to_majorana, optimize_governance, run_full_simulation from agt_majorana_simulation ---\n",
    "class AgileGovernance:\n",
    "    def __init__(self):\n",
    "        self.params = {\n",
    "            \"strategy\": 1.0,\n",
    "            \"structure\": 1.0,\n",
    "            \"capability\": 1.0,\n",
    "            \"control\": 1.0,\n",
    "            \"transparency\": 1.0,\n",
    "            \"environment\": 1.0\n",
    "        }\n",
    "        self.history = []\n",
    "\n",
    "    def state_vector(self) -> np.ndarray:\n",
    "        vec = np.array([\n",
    "            self.params[\"strategy\"],\n",
    "            self.params[\"structure\"],\n",
    "            self.params[\"capability\"],\n",
    "            self.params[\"control\"],\n",
    "            self.params[\"transparency\"]\n",
    "        ])\n",
    "        return vec / (np.linalg.norm(vec) + const.EPS)\n",
    "\n",
    "    def entropy(self) -> float:\n",
    "        p = np.abs(self.state_vector())**2\n",
    "        p = p[p > const.EPS]\n",
    "        return -np.sum(p * np.log(p + const.EPS))\n",
    "\n",
    "    def agility_index(self) -> float:\n",
    "        S = self.params[\"strategy\"]\n",
    "        St = self.params[\"structure\"]\n",
    "        Cp = self.params[\"capability\"]\n",
    "        Ct = self.params[\"control\"]\n",
    "        T = self.params[\"transparency\"]\n",
    "        E = self.params[\"environment\"]\n",
    "        alignment = S * Ct\n",
    "        responsiveness = Cp * T\n",
    "        complexity = St * (1 + np.abs(E - 1))\n",
    "        return (alignment * responsiveness) / (complexity + const.EPS)\n",
    "\n",
    "    def stability(self) -> float:\n",
    "        return 1.0 / (1.0 + self.entropy())\n",
    "\n",
    "    def run_cycle(self) -> Dict:\n",
    "        results = {\n",
    "            \"timestamp\": time.time(),\n",
    "            \"params\": self.params.copy(),\n",
    "            \"entropy\": self.entropy(),\n",
    "            \"agility\": self.agility_index(),\n",
    "            \"stability\": self.stability()\n",
    "        }\n",
    "        self.history.append(results)\n",
    "        return results\n",
    "\n",
    "def map_governance_to_majorana(agt: AgileGovernance) -> Tuple[np.ndarray, Dict]:\n",
    "    g_vec = agt.state_vector()\n",
    "    n = len(g_vec)\n",
    "    psi_maj = core.quantum.majorana_state(n_dim=2**n)\n",
    "    gamma = core.relativity.gamma_factor(0.99 * const.c)\n",
    "    phase = np.exp(-1j * np.pi * agt.agility_index() * gamma)\n",
    "    psi_maj = core.quantum.normalize(psi_maj * phase)\n",
    "    rho = core.quantum.density_matrix(psi_maj)\n",
    "    S_q = core.quantum.von_neumann_entropy(rho)\n",
    "    fidelity = core.quantum.hilbert_norm(psi_maj)\n",
    "    coherence = 1.0 - S_q / np.log2(len(psi_maj) + const.EPS)\n",
    "    sigma_z = np.eye(2**n, dtype=complex) # Placeholder logic\n",
    "    q_eff = np.real(np.vdot(psi_maj, sigma_z @ psi_maj))\n",
    "    return psi_maj, {\n",
    "        \"quantum_entropy\": S_q,\n",
    "        \"coherence\": coherence,\n",
    "        \"effective_charge\": q_eff,\n",
    "        \"fidelity\": fidelity,\n",
    "        \"gamma\": gamma\n",
    "    }\n",
    "\n",
    "def optimize_governance(agt: AgileGovernance, target_coherence: float = 0.95) -> Dict:\n",
    "    def objective(x: np.ndarray) -> float:\n",
    "        agt.params[\"strategy\"] = np.clip(x[0], 0.1, 2.0)\n",
    "        agt.params[\"structure\"] = np.clip(x[1], 0.1, 2.0)\n",
    "        agt.params[\"capability\"] = np.clip(x[2], 0.1, 2.0)\n",
    "        agt.params[\"control\"] = np.clip(x[3], 0.1, 2.0)\n",
    "        agt.params[\"transparency\"] = np.clip(x[4], 0.1, 2.0)\n",
    "        _, q_data = map_governance_to_majorana(agt)\n",
    "        return q_data[\"quantum_entropy\"] + (target_coherence - q_data[\"coherence\"])**2\n",
    "    x0 = np.array([agt.params[k] for k in [\"strategy\",\"structure\",\"capability\",\"control\",\"transparency\"]])\n",
    "    res = minimize(objective, x0, method=\"L-BFGS-B\", bounds=[(0.1,2.0)]*5)\n",
    "    return {\"success\": res.success, \"iterations\": res.nit, \"optimal_parameters\": agt.params.copy(), \"final_objective\": res.fun}\n",
    "\n",
    "def run_full_simulation(environment_turbulence: float = 1.2, optimize: bool = True) -> Dict:\n",
    "    print(\"=\" * 90)\n",
    "    print(\"🚀 AGILE GOVERNANCE ⇄ MAJORANA SYSTEM — FULL SIMULATION\")\n",
    "    print(\"=\" * 90)\n",
    "    agt = AgileGovernance()\n",
    "    agt.params[\"environment\"] = environment_turbulence\n",
    "    baseline = agt.run_cycle()\n",
    "    _, q_baseline = map_governance_to_majorana(agt)\n",
    "    optimized = baseline.copy() # Initialize optimized with baseline\n",
    "    if optimize:\n",
    "        opt_results = optimize_governance(agt, target_coherence=0.98)\n",
    "        optimized[\"params\"] = agt.params.copy() # Store final optimized parameters\n",
    "        # Re-run cycle with optimized parameters to get updated metrics\n",
    "        optimized.update(agt.run_cycle())\n",
    "    output = {\"metadata\": core.metadata.generate(name=\"AGT_Majorana_Simulation\", inputs={\"env\": environment_turbulence}, results={\n",
    "\"baseline\": baseline, \"optimized\": optimized})}\n",
    "    print(\"✅ Simulation Complete\")\n",
    "    return output\n",
    "# -----------------------------------------------------------------------------------------------------\n",
    "\n",
    "# Initialize core\n",
    "core = UnifiedFramework()\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "plt.rcParams['figure.dpi'] = 100\n",
    "\n",
    "# =============================================================================\n",
    "# 1. ELLIPSOIDAL GEOMETRY FOR SYSTEM STATE\n",
    "# =============================================================================\n",
    "def state_to_ellipsoid(psi: np.ndarray, agt_metrics: Dict) -> Dict:\n",
    "    \"\"\"Map quantum/governance state to ellipsoid parameters\"\"\"\n",
    "    amps = np.abs(psi)\n",
    "    # Semi-axes proportional to normalized amplitudes\n",
    "    a = np.max(amps) * 1.0\n",
