    "\n",
    "# =============================================================================\n",
    "# SECTION 1: FUNDAMENTAL CONSTANTS & UNITS\n",
    "# =============================================================================\n",
    "class PhysicalConstants:\n",
    "    \"\"\"Universal constants and unit conversions — SI + Natural Units\"\"\"\n",
    "    def __init__(self):\n",
    "        # Fundamental constants\n",
    "        self.c       = 299792458.0                  # Speed of light [m/s]\n",
    "        self.G       = 6.67430e-11                  # Gravitational constant [m³/kg·s²]\n",
    "        self.h       = 6.62607015e-34               # Planck constant [J·s]\n",
    "        self.hbar    = self.h / (2 * np.pi)         # Reduced Planck\n",
    "        self.e       = 1.602176634e-19              # Elementary charge [C]\n",
    "        self.m_e     = 9.1093837015e-31             # Electron mass [kg]\n",
    "        self.m_p     = 1.67262192369e-27            # Proton mass [kg]\n",
    "        self.k_B     = 1.380649e-23                 # Boltzmann constant [J/K]\n",
    "        self.mu_0    = 4 * np.pi * 1e-7             # Vacuum permeability [H/m]\n",
    "        self.eps_0   = 1 / (self.mu_0 * self.c**2)  # Vacuum permittivity [F/m]\n",
    "        self.alpha   = self.e**2 / (4 * np.pi * self.eps_0 * self.hbar * self.c) # Fine structure\n",
    "        self.EPS     = 1e-12                        # Numerical regularization\n",
    "\n",
    "    def to_natural(self, value: float, dimension: str) -> float:\n",
    "        \"\"\"Convert SI to natural units (c = ℏ = kB = 1)\"\"\"\n",
    "        if dimension == \"energy\":\n",
    "            return value / (self.hbar * self.c)\n",
    "        elif dimension == \"mass\":\n",
    "            return value * self.c**2 / (self.hbar * self.c)\n",
    "        elif dimension == \"length\":\n",
    "            return value * self.hbar / (self.m_e * self.c)\n",
    "        return value\n",
    "\n",
    "const = PhysicalConstants()\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 2: CLASSICAL & RELATIVISTIC MECHANICS\n",
    "# =============================================================================\n",
    "class RelativisticMechanics:\n",
    "    \"\"\"Laws of motion, Lorentz transformations, energy‑momentum\"\"\"\n",
    "    @staticmethod\n",
    "    def lorentz_matrix(v: float, dim: int = 4) -> np.ndarray:\n",
    "        \"\"\"Regularized 4D Lorentz boost matrix\"\"\"\n",
    "        beta = np.clip(v / const.c, -0.99999999, 0.99999999)\n",
    "        gamma = 1 / np.sqrt(1 - beta**2 + const.EPS)\n",
    "        L = np.eye(dim, dtype=np.float64)\n",
    "        L[0,0] = gamma; L[0,1] = -gamma * beta\n",
    "        L[1,0] = -gamma * beta; L[1,1] = gamma\n",
    "        return L\n",
    "\n",
    "    @staticmethod\n",
    "    def gamma_factor(v: float) -> float:\n",
    "        \"\"\"γ = 1 / √(1 − v²/c²)\"\"\"\n",
    "        return 1 / np.sqrt(1 - (v/const.c)**2 + const.EPS)\n",
    "\n",
    "    @staticmethod\n",
    "    def energy_momentum(m: float, v: float) -> np.ndarray:\n",
    "        \"\"\"4‑momentum vector [E/c, pₓ, pᵧ, p_z]ᵀ\"\"\"\n",
    "        g = RelativisticMechanics.gamma_factor(v)\n",
    "        E = g * m * const.c**2\n",
    "        p = g * m * v\n",
    "        return np.array([E/const.c, p, 0, 0])\n",
    "\n",
    "    @staticmethod\n",
    "    def minkowski_metric(signature: str = \"-+++\") -> np.ndarray:\n",
    "        \"\"\"Metric tensor of flat spacetime\"\"\"\n",
    "        if signature == \"-+++\":\n",
    "            return np.diag([-1, 1, 1, 1])\n",
    "        return np.diag([1, -1, -1, -1])\n",
    "\n",
    "    @staticmethod\n",
    "    def geodesic_equation(x: np.ndarray, v: np.ndarray, Gamma: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"d²xᵃ/dτ² + Γᵃᵦᵧ vᵇ vᶜ = 0\"\"\"\n",
    "        dvdt = -np.einsum('abc,b,c->a', Gamma, v, v)\n",
    "        return dvdt\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 3: HILBERT SPACE & QUANTUM MECHANICS\n",
    "# =============================================================================\n",
    "class QuantumMechanics:\n",
    "    \"\"\"Postulates, operators, states, Majorana conditions\"\"\"\n",
    "    @staticmethod\n",
    "    def hilbert_inner(psi1: np.ndarray, psi2: np.ndarray) -> complex:\n",
    "        \"\"\"Inner product ⟨ψ₁|ψ₂⟩\"\"\"\n",
    "        return np.vdot(psi1, psi2)\n",
    "\n",
    "    @staticmethod\n",
    "    def hilbert_norm(psi: np.ndarray) -> float:\n",
    "        \"\"\"||ψ|| = √⟨ψ|ψ⟩\"\"\"\n",
    "        return np.sqrt(np.real(QuantumMechanics.hilbert_inner(psi, psi)) + const.EPS)\n",
    "\n",
    "    @staticmethod\n",
    "    def normalize(psi: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"Normalize state vector\"\"\"\n",
    "        return psi / QuantumMechanics.hilbert_norm(psi)\n",
    "\n",
    "    @staticmethod\n",
    "    def projection_operator(psi: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"P = |ψ⟩⟨ψ|\"\"\"\n",
    "        return np.outer(psi, np.conj(psi))\n",
    "\n",
    "    @staticmethod\n",
    "    def charge_conjugation() -> np.ndarray:\n",
    "        \"\"\"C operator for Majorana states\"\"\"\n",
    "        return np.array([[0, -1j], [1j, 0]], dtype=complex)\n",
    "\n",
    "    @staticmethod\n",
    "    def majorana_state(n_dim: int = 4) -> np.ndarray:\n",
    "        \"\"\"Construct self‑conjugated Majorana state\"\"\"\n",
    "        C = QuantumMechanics.charge_conjugation()\n",
    "        theta = np.pi / (2 * (1 + np.sqrt(5))/2)\n",
    "        phi = np.log((1 + np.sqrt(5))/2 + 1) / np.log(2)\n",
    "        psi0 = np.array([np.cos(theta), np.sin(theta)*np.exp(-1j*phi)], dtype=complex)\n",
    "        psi_c = C @ np.conj(psi0)\n",
    "        psi_maj = QuantumMechanics.normalize(psi0 + psi_c)\n",
    "        while len(psi_maj) < n_dim:\n",
    "            psi_maj = QuantumMechanics.normalize(np.kron(psi_maj, psi_maj))\n",
    "        return psi_maj\n",
    "\n",
    "    @staticmethod\n",
    "    def density_matrix(psi: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"ρ = |ψ⟩⟨ψ|\"\"\"\n",
    "        return np.outer(psi, np.conj(psi))\n",
    "\n",
    "    @staticmethod\n",
    "    def von_neumann_entropy(rho: np.ndarray) -> float:\n",
    "        \"\"\"S = −Tr(ρ ln ρ)\"\"\"\n",
    "        evals = np.linalg.eigvalsh(rho)\n",
    "        evals = evals[evals > const.EPS]\n",
    "        return -np.sum(evals * np.log(evals))\n",
    "\n",
    "    @staticmethod\n",
    "    def decoherence_correction(psi: np.ndarray, noise: float = 0.01) -> Tuple[np.ndarray, float]:\n",
    "        \"\"\"Project onto coherent subspace, return fidelity\"\"\"\n",
    "        rho = QuantumMechanics.density_matrix(psi)\n",
    "        rho_corr = expm(-noise * logm(rho + const.EPS * np.eye(rho.shape[0])))\n",
    "        rho_corr /= np.trace(rho_corr)\n",
    "        evals, evecs = eigh(rho_corr)\n",
    "        psi_new = QuantumMechanics.normalize(evecs[:, np.argmax(evals)])\n",
    "        fidelity = np.abs(QuantumMechanics.hilbert_inner(psi, psi_new))**2\n",
    "        return psi_new, fidelity\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 4: MATRIX ALGEBRA & IDENTITIES\n",
    "# =============================================================================\n",
    "class MatrixAlgebra:\n",
    "    \"\"\"All fundamental matrix operations, identities, invariants\"\"\"\n",
    "    @staticmethod\n",
    "    def is_hermitian(M: np.ndarray) -> bool:\n",
    "        return np.allclose(M, np.conj(M.T), atol=const.EPS)\n",
    "\n",
    "    @staticmethod\n",
    "    def is_unitary(U: np.ndarray) -> bool:\n",
    "        return np.allclose(np.conj(U.T) @ U, np.eye(U.shape[0]), atol=const.EPS)\n",
    "\n",
    "    @staticmethod\n",
    "    def matrix_exponential(A: np.ndarray, terms: int = 20) -> np.ndarray:\n",
    "        \"\"\"eᴬ = Σₙ Aⁿ / n!\"\"\"\n",
    "        res = np.eye(A.shape[0], dtype=complex)\n",
    "        term = np.eye(A.shape[0], dtype=complex)\n",
    "        for n in range(1, terms+1):\n",
    "            term = term @ A / n\n",
    "            res += term\n",
    "        return res\n",
    "\n",
    "    @staticmethod\n",
    "    def matrix_logarithm(M: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"ln(M) for positive definite M\"\"\"\n",
    "        return logm(M + const.EPS * np.eye(M.shape[0]))\n",
    "\n",
    "    @staticmethod\n",
    "    def invariants(M: np.ndarray) -> Dict[str, float]:\n",
    "        \"\"\"Trace, determinant, norm, condition\"\"\"\n",
    "        return {\n",
    "            \"trace\": np.trace(M),\n",
    "            \"det\": det(M),\n",
    "            \"norm_fro\": norm(M, 'fro'),\n",
    "            \"condition\": np.linalg.cond(M),\n",
    "            \"rank\": np.linalg.matrix_rank(M)\n",
    "        }\n",
    "\n",
    "    @staticmethod\n",
    "    def identity_trace(A: np.ndarray, B: np.ndarray) -> bool:\n",
    "        \"\"\"Tr(AB) = Tr(BA)\"\"\"\n",
    "        return np.allclose(np.trace(A@B), np.trace(B@A), atol=const.EPS)\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 5: MACHINE LEARNING ON MATRICES\n",
    "# =============================================================================\n",
    "class MatrixLearning:\n",
    "    \"\"\"Optimization, feature extraction, learning operators\"\"\"\n",
    "    @staticmethod\n",
    "    def loss_frobenius(M_true: np.ndarray, M_pred: np.ndarray) -> float:\n",
    "        \"\"\"L = ||M_true − M_pred||²_F\"\"\"\n",
    "        return norm(M_true - M_pred, 'fro')**2\n",
    "\n",
    "    @staticmethod\n",
    "    def learn_linear_map(X: np.ndarray, Y: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"Find A such that A X ≈ Y\"\"\"\n",
    "        def objective(A_flat):\n",
    "            A = A_flat.reshape(Y.shape[0], X.shape[0])\n",
    "            return norm(A @ X - Y, 'fro')**2\n",
    "        res = minimize(objective, np.random.rand(Y.shape[0]*X.shape[0]), method='L-BFGS-B')\n",
    "        return res.x.reshape(Y.shape[0], X.shape[0])\n",
    "\n",
    "    @staticmethod\n",
    "    def matrix_features(M: np.ndarray) -> Dict[str, Any]:\n",
    "        \"\"\"Extract all relevant features for analysis\"\"\"\n",
    "        return {**MatrixAlgebra.invariants(M), \"eigenvalues\": eigvals(M).tolist()}\n",
    "\n",
    "    @staticmethod\n",
    "    def optimize_coherence(rho: np.ndarray) -> Tuple[np.ndarray, float]:\n",
    "        \"\"\"Maximize coherence by adjusting basis\"\"\"\n",
    "        def loss(U_flat):\n",
    "            U = U_flat.reshape(rho.shape)\n",
    "            U = U / norm(U)\n",
    "            rho_t = U @ rho @ np.conj(U.T)\n",
    "            return QuantumMechanics.von_neumann_entropy(rho_t)\n",
    "        res = minimize(loss, np.random.rand(rho.size), method='L-BFGS-B')\n",
    "        U_opt = res.x.reshape(rho.shape)\n",
    "        U_opt = U_opt / norm(U_opt)\n",
    "        rho_opt = U_opt @ rho @ np.conj(U_opt.T)\n",
    "        return rho_opt, 1 - QuantumMechanics.von_neumann_entropy(rho_opt)/np.log2(rho.shape[0])\n",
    "\n",
    "# =============================================================================\n",
    "# SECTION 6: ELLIPSOIDAL GEOMETRY & METRICS\n",
    "# =============================================================================\n",
    "class EllipsoidGeometry:\n",
    "    \"\"\"Parametrization, metrics, invariants, coordinate systems\"\"\"\n",
    "    @staticmethod\n",
    "    def parametric(a: float, b: float, c: float, u: float, v: float) -> np.ndarray:\n",
    "        \"\"\"x = a sinu cosv, y = b sinu sinv, z = c cosu\"\"\"\n",
    "        return np.array([\n",
    "            a * np.sin(u) * np.cos(v),\n",
    "            b * np.sin(u) * np.sin(v),\n",
    "            c * np.cos(u)\n",
    "        ])\n",
    "\n",
    "    @staticmethod\n",
    "    def metric_tensor(a: float, b: float, c: float, u: float, v: float) -> np.ndarray:\n",
    "        \"\"\"First fundamental form\"\"\"\n",
    "        E = (a*np.cos(u)*np.cos(v))**2 + (b*np.cos(u)*np.sin(v))**2 + (c*np.sin(u))**2\n",
    "        F = (b**2 - a**2) * np.sin(u)*np.cos(u)*np.sin(v)*np.cos(v)\n",
    "        G = (a*np.sin(v))**2 + (b*np.cos(v))**2 * np.sin(u)**2\n",
    "        return np.array([[E, F], [F, G]])\n",
    "\n",
    "    @staticmethod\n",
    "    def volume(a: float, b: float, c: float) -> float:\n",
    "        \"\"\"V = (4/3)πabc\"\"\"\n",
    "        return (4/3) * np.pi * a * b * c\n",
    "\n",
    "    @staticmethod\n",
    "    def inertia_tensor(a: float, b: float, c: float, mass: float) -> np.ndarray:\n",
    "        \"\"\"Moment of inertia for homogeneous ellipsoid\"\"\"\n",
    "        Ix = mass * (b**2 + c**2) / 5\n",
    "        Iy = mass * (a**2 + c**2) / 5\n",
    "        Iz = mass * (a**2 + b**2) / 5\n",
    "        return np.diag([Ix, Iy, Iz])\n",
