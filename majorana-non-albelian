    "import matplotlib.pyplot as plt\n",
    "import json\n",
    "from scipy.fft import fft, fftfreq\n",
    "\n",
    "# Load amplitudes from the core output\n",
    "with open('quantum_core_output.json', 'r') as f:\n",
    "    data = json.load(f)\n",
    "\n",
    "amplitudes = np.array(data['arrays']['amplitudes'])\n",
    "N = len(amplitudes)\n",
    "\n",
    "# Perform Spectral Analysis (FFT)\n",
    "# We treat the basis indices as a spatial/sequential domain\n",
    "yf = fft(amplitudes)\n",
    "xf = fftfreq(N, 1)[:N//2]\n",
    "\n",
    "# Visualization\n",
    "plt.figure(figsize=(12, 5))\n",
    "\n",
    "# Plot 1: Power Spectrum\n",
    "plt.subplot(1, 2, 1)\n",
    "plt.plot(xf, 2.0/N * np.abs(yf[0:N//2]), color='crimson', marker='o')\n",
    "plt.title('Quantum Amplitude Power Spectrum')\n",
    "plt.xlabel('Frequency (Cycles per Index)')\n",
    "plt.ylabel('Magnitude')\n",
    "plt.grid(True, linestyle='--', alpha=0.7)\n",
    "\n",
    "# Plot 2: Phase Spectrum\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.stem(xf, np.angle(yf[0:N//2]), linefmt='grey', markerfmt='D', basefmt=' ')\n",
    "plt.title('Spectral Phase Distribution')\n",
    "plt.xlabel('Frequency')\n",
    "plt.ylabel('Phase (radians)')\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Output dominant frequency\n",
    "dom_freq = xf[np.argmax(np.abs(yf[0:N//2]))]\n",
    "print(f\"✅ Spectral Analysis Complete.\")\n",
    "print(f\"Dominant Frequency Component: {dom_freq:.4f} cycles/index\")"
   ]
