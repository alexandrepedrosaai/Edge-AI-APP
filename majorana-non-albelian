    "import pandas as pd\n",
    "from scipy.stats import chisquare\n",
    "\n",
    "# 1. Load the exported ledger file\n",
    "df_verify = pd.read_csv('quantum_ledger_verification.csv')\n",
    "\n",
    "# 2. Extract first hex character and calculate counts\n",
    "verify_chars = df_verify['sha3_512_hash'].str[0].str.lower()\n",
    "hex_labels = [hex(i)[2:] for i in range(16)]\n",
    "verify_counts = verify_chars.value_counts().reindex(hex_labels, fill_value=0)\n",
    "\n",
    "# 3. Perform Statistical Validation on File Data\n",
    "expected = [len(df_verify) / 16] * 16\n",
    "chi2_file, p_file = chisquare(f_obs=verify_counts.values, f_exp=expected)\n",
    "\n",
    "# 4. Display Comparison\n",
    "print(f\"[FILE DATA] Total Blocks: {len(df_verify)}\")\n",
    "print(f\"[FILE DATA] Chi-squared: {chi2_file:.4f}\")\n",
    "print(f\"[FILE DATA] P-value: {p_file:.4f}\")\n",
    "\n",
    "# Check against the latest kernel p_value if it exists\n",
    "if 'p_value' in globals():\n",
    "    print(f\"\\n[KERNEL DATA] Previous P-value: {p_value:.4f}\")\n",
    "    diff = abs(p_file - p_value)\n",
    "    print(f\"[RESULT] Divergence: {diff:.2e}\")\n",
    "\n",
    "display(verify_counts.to_frame(name='Frequency').T)"
   ]
