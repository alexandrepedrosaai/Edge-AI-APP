    "import numpy as np\n",
    "import json\n",
    "import hashlib\n",
    "import time\n",
    "from typing import List, Dict\n",
    "\n",
    "# The functions 'state_to_matrix_arrays' and 'majorana_state' are assumed\n",
    "# to be defined in previous cells of this notebook.\n",
    "\n",
    "class QuantumBlock:\n",
    "    def __init__(self, index: int, state_arrays: Dict, prev_hash: str):\n",
    "        self.index = index\n",
    "        self.timestamp = time.time()\n",
    "        self.state_arrays = state_arrays\n",
    "        self.prev_hash = prev_hash\n",
    "        self.data_str = self._serialize()\n",
    "        self.hash = self._compute_hash()\n",
    "\n",
    "    def _serialize(self) -> str:\n",
    "        return json.dumps({\n",
    "            \"index\": self.index,\n",
    "            \"timestamp\": self.timestamp,\n",
    "            \"state\": self.state_arrays,\n",
    "            \"prev_hash\": self.prev_hash\n",
    "        }, sort_keys=True)\n",
    "\n",
    "    def _compute_hash(self) -> str:\n",
    "        return hashlib.sha3_512(self.data_str.encode()).hexdigest()\n",
    "\n",
    "    def to_dict(self) -> Dict:\n",
    "        return {\n",
    "            \"index\": self.index,\n",
    "            \"timestamp\": self.timestamp,\n",
    "            \"state_arrays\": self.state_arrays,\n",
    "            \"prev_hash\": self.prev_hash,\n",
    "            \"hash\": self.hash\n",
    "        }\n",
    "\n",
    "class QuantumBlockchain:\n",
    "    def __init__(self):\n",
    "        self.chain: List[QuantumBlock] = []\n",
    "        self._create_genesis()\n",
    "\n",
    "    def _create_genesis(self):\n",
    "        genesis_state = {\"amplitudes\": [1.0], \"phases\": [0.0], \"log_amplitudes\": [0.0], \"trig_amplitudes\": [0.0]}\n",
    "        genesis = QuantumBlock(0, genesis_state, \"0\" * 128)\n",
    "        self.chain.append(genesis)\n",
    "\n",
    "    def add_state(self, psi: np.ndarray) -> str:\n",
    "        # Using state_to_matrix_arrays from global scope\n",
    "        arrays = state_to_matrix_arrays(psi)\n",
    "        prev_hash = self.chain[-1].hash\n",
    "        new_block = QuantumBlock(len(self.chain), arrays, prev_hash)\n",
    "        self.chain.append(new_block)\n",
    "        return new_block.hash\n",
    "\n",
    "    def verify_chain(self) -> bool:\n",
    "        for i in range(1, len(self.chain)):\n",
    "            if self.chain[i].prev_hash != self.chain[i-1].hash:\n",
    "                return False\n",
    "            if self.chain[i].hash != self.chain[i]._compute_hash():\n",
    "                return False\n",
    "        return True\n",
    "\n",
    "    def export_chain(self, path: str = \"quantum_blockchain.json\"):\n",
    "        data = [b.to_dict() for b in self.chain]\n",
    "        with open(path, \"w\") as f:\n",
    "            json.dump(data, f, indent=2)\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    qbc = QuantumBlockchain()\n",
    "    for n in range(3, 6):\n",
    "        # Using majorana_state from global scope\n",
    "        psi = majorana_state(n)\n",
    "        h = qbc.add_state(psi)\n",
    "        print(f\"Block {len(qbc.chain)-1} | Hash: {h[:16]}...\")\n",
    "\n",
    "    print(f\"Chain valid: {qbc.verify_chain()}\")\n",
    "    qbc.export_chain()"
   ]
