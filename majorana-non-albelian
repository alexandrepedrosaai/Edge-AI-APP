    "# =============================================================================\n",
    "# AZURE QUANTUM CORE: HILBERT SPACE & MAJORANA STATES\n",
    "# Matrix formalism, decoherence correction, superposition arrays\n",
    "# =============================================================================\n",
    "\n",
    "import numpy as np\n",
    "from scipy.linalg import eigh, logm, expm\n",
    "import json\n",
    "import hashlib\n",
    "from typing import Tuple, Dict\n",
    "\n",
    "# Physical & mathematical constants\n",
    "c       = 299792458.0\n",
    "hbar    = 1.054571817e-34\n",
    "e       = 1.602176634e-19\n",
    "PI      = np.pi\n",
    "EULER   = np.e\n",
    "PHI     = (1 + np.sqrt(5)) / 2\n",
    "LN2     = np.log(2)\n",
    "EPS     = 1e-12\n",
    "ALPHA   = PHI\n",
    "\n",
    "def pauli_basis() -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:\n",
    "    \"\"\"Pauli matrices and identity operator\"\"\"\n",
    "    I = np.eye(2, dtype=complex)\n",
    "    sx = np.array([[0, 1], [1, 0]], dtype=complex)\n",
    "    sy = np.array([[0, -1j], [1j, 0]], dtype=complex)\n",
    "    sz = np.array([[1, 0], [0, -1]], dtype=complex)\n",
    "    return I, sx, sy, sz\n",
    "\n",
    "def charge_conjugation() -> np.ndarray:\n",
    "    \"\"\"Operator C for Majorana condition Ψ = Ψᶜ\"\"\"\n",
    "    _, _, sy, _ = pauli_basis()\n",
    "    return 1j * sy\n",
    "\n",
    "def hilbert_norm(psi: np.ndarray) -> float:\n",
    "    \"\"\"Normalization in Hilbert space\"\"\"\n",
    "    return np.sqrt(np.vdot(psi, psi).real + EPS)\n",
    "\n",
    "def hilbert_projection(psi: np.ndarray, subspace: list) -> np.ndarray:\n",
    "    \"\"\"Project onto closed subspace to suppress decoherence\"\"\"\n",
    "    proj = np.zeros_like(psi, dtype=complex)\n",
    "    for idx in subspace:\n",
    "        proj[idx] = psi[idx]\n",
    "    return proj / hilbert_norm(proj)\n",
    "\n",
    "def majorana_state(n_qubits: int = 3) -> np.ndarray:\n",
    "    \"\"\"Construct perfect Majorana state with trigonometric/logarithmic phase\"\"\"\n",
    "    C = charge_conjugation()\n",
    "    theta = PI / (2 * PHI)\n",
    "    phi = np.log(1 + PHI)\n",
    "    psi0 = np.array([np.cos(theta), np.sin(theta) * np.exp(-1j * phi)], dtype=complex)\n",
    "    psi_c = C @ psi0.conj()\n",
    "    psi_maj = psi0 + psi_c\n",
    "    psi_maj = psi_maj / hilbert_norm(psi_maj)\n",
    "\n",
    "    # Using np.kron instead of scipy.linalg.kron to avoid AxisError with 1D vectors\n",
    "    for _ in range(n_qubits - 1):\n",
    "        psi_maj = np.kron(psi_maj, psi_maj)\n",
    "        psi_maj = psi_maj / hilbert_norm(psi_maj)\n",
    "    return psi_maj\n",
    "\n",
    "def density_matrix(psi: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"ρ = |Ψ⟩⟨Ψ|\"\"\"\n",
    "    return np.outer(psi, psi.conj())\n",
    "\n",
    "def von_neumann_entropy(rho: np.ndarray) -> float:\n",
    "    \"\"\"S = -Tr(ρ ln ρ) — decoherence measure\"\"\"\n",
    "    evals, _ = eigh(rho)\n",
    "    evals = evals[evals > EPS]\n",
    "    return -np.sum(evals * np.log(evals + EPS))\n",
    "\n",
    "def coherence_index(S: float) -> float:\n",
    "    \"\"\"Coherence = 1 - S / ln(dim)\"\"\"\n",
    "    dim = 2 ** 3\n",
    "    return max(0.0, 1.0 - S / np.log(dim + EPS))\n",
    "\n",
    "def state_to_matrix_arrays(psi: np.ndarray) -> Dict:\n",
    "    \"\"\"Convert quantum state to structured numerical arrays\"\"\"\n",
    "    amps = np.abs(psi).astype(np.float64)\n",
    "    phases = np.angle(psi).astype(np.float64) / PI\n",
    "    log_amps = np.log(amps + EPS)\n",
    "    trig_amps = np.sin(2 * PI * amps)\n",
    "    return {\n",
    "        \"amplitudes\": amps.tolist(),\n",
    "        \"phases\": phases.tolist(),\n",
    "        \"log_amplitudes\": log_amps.tolist(),\n",
    "        \"trig_amplitudes\": trig_amps.tolist(),\n",
    "        \"norm\": hilbert_norm(psi)\n",
    "    }\n",
    "\n",
    "def quantum_hash(data: np.ndarray) -> str:\n",
    "    \"\"\"Immutable hash of quantum state snapshot\"\"\"\n",
    "    flat = np.round(data, 12).flatten().tobytes()\n",
    "    return hashlib.sha3_512(flat).hexdigest()\n",
    "\n",
    "# Example output\n",
    "if __name__ == \"__main__\":\n",
    "    psi_res = majorana_state(3)\n",
    "    rho_res = density_matrix(psi_res)\n",
    "    S_res = von_neumann_entropy(rho_res)\n",
    "    coh_res = coherence_index(S_res)\n",
    "    arrays_res = state_to_matrix_arrays(psi_res)\n",
    "    qhash_res = quantum_hash(psi_res)\n",
    "\n",
    "    print(f\"Majorana State |Ψ⟩:\\n{np.round(psi_res, 6)}\")\n",
    "    print(f\"Entropy S = {S_res:.8e}\")\n",
    "    print(f\"Coherence = {coh_res:.6f}\")\n",
    "    print(f\"Immutable Hash = {qhash_res[:16]}...\")\n",
    "\n",
