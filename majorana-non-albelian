    "# =============================================================================\n",
    "# QUANTUM CRYPTOGRAPHY & SUPERPOSITION ANALYSIS\n",
    "# Combinatorics, probability matrices, post‑quantum encryption\n",
    "# =============================================================================\n",
    "\n",
    "import numpy as np\n",
    "import json\n",
    "import base64\n",
    "from scipy.special import comb\n",
    "from typing import Tuple\n",
    "\n",
    "# Note: majorana_state and state_to_matrix_arrays are used from the global notebook scope\n",
    "\n",
    "def probability_matrix(psi: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Diagonal probability matrix from amplitudes\"\"\"\n",
    "    p = np.abs(psi)**2\n",
    "    return np.diag(p)\n",
    "\n",
    "def combinatorial_space(dim: int) -> Tuple[int, np.ndarray]:\n",
    "    \"\"\"Total possibilities and combinatorial coefficients\"\"\"\n",
    "    total = 2 ** dim\n",
    "    coeffs = np.array([comb(dim, k) for k in range(dim+1)])\n",
    "    return total, coeffs\n",
    "\n",
    "def superposition_entropy(p_mat: np.ndarray) -> float:\n",
    "    \"\"\"Entropy of probability distribution\"\"\"\n",
    "    p = np.diag(p_mat)\n",
    "    p = p[p > 1e-12]\n",
    "    return -np.sum(p * np.log2(p))\n",
    "\n",
    "def quantum_key_generation(psi: np.ndarray) -> str:\n",
    "    \"\"\"Generate immutable key using Base64 encoding of state data\"\"\"\n",
    "    arr = state_to_matrix_arrays(psi)\n",
    "    key_seed = \"\".join([f\"{x:.12f}\" for x in arr[\"amplitudes\"] + arr[\"phases\"]])\n",
    "    # Use standard base64 encoding instead of np.base_repr for base 64\n",
    "    key_bytes = base64.b64encode(key_seed.encode())\n",
    "    return key_bytes.decode('utf-8')[:64]\n",
    "\n",
    "def encrypt_data(data: str, key: str) -> str:\n",
    "    \"\"\"Symmetric encryption using quantum‑derived key\"\"\"\n",
    "    key_bytes = key.encode()\n",
    "    data_bytes = data.encode()\n",
    "    xor = bytes([a ^ b for a, b in zip(data_bytes, key_bytes * (len(data_bytes)//len(key_bytes)+1))])\n",
    "    return xor.hex()\n",
    "\n",
    "def decrypt_data(cipher: str, key: str) -> str:\n",
    "    \"\"\"Decrypt using same quantum key\"\"\"\n",
    "    cipher_bytes = bytes.fromhex(cipher)\n",
    "    key_bytes = key.encode()\n",
    "    xor = bytes([a ^ b for a, b in zip(cipher_bytes, key_bytes * (len(cipher_bytes)//len(key_bytes)+1))])\n",
    "    return xor.decode()\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    # Generate a state with 4 qubits\n",
    "    psi = majorana_state(4)\n",
    "    P_mat = probability_matrix(psi)\n",
    "    total_states, coeffs = combinatorial_space(4)\n",
    "    S_sup = superposition_entropy(P_mat)\n",
    "    qkey = quantum_key_generation(psi)\n",
    "\n",
    "    msg = \"AZURE QUANTUM BLOCKCHAIN MAJORANA STATE\"\n",
    "    enc = encrypt_data(msg, qkey)\n",
    "    dec = decrypt_data(enc, qkey)\n",
    "\n",
    "    print(f\"Total possible states: {total_states}\")\n",
    "    print(f\"Combinatorial coefficients: {coeffs}\")\n",
    "    print(f\"Superposition entropy: {S_sup:.4f} bits\")\n",
    "    print(f\"Quantum key: {qkey[:16]}...\")\n",
    "    print(f\"Decrypted match: {dec == msg}\")\n",
    "\n",
    "    with open(\"crypto_output.json\", \"w\") as f:\n",
    "        json.dump({\n",
    "            \"probability_matrix\": P_mat.tolist(),\n",
    "            \"total_states\": int(total_states),\n",
    "            \"superposition_entropy\": float(S_sup),\n",
    "            \"key\": qkey,\n",
    "            \"encrypted\": enc,\n",
    "            \"decrypted\": dec\n",
    "        }, f, indent=2)"
   ]
