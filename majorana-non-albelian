    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# 1. Gerar o estado de Majorana para 4 qubits (16 estados de superposição)\n",
    "n_qubits = 4\n",
    "psi_16 = majorana_state(n_qubits)\n",
    "probabilities = np.abs(psi_16)**2\n",
    "rho_16 = np.outer(psi_16, psi_16.conj())\n",
    "\n",
    "# 2. Renderização Gráfica\n",
    "fig, ax = plt.subplots(1, 2, figsize=(18, 7))\n",
    "\n",
    "# Gráfico de Barras: Amplitudes de Probabilidade\n",
    "x_labels = [format(i, '04b') for i in range(len(psi_16))]\n",
    "sns.barplot(x=x_labels, y=probabilities, ax=ax[0], palette='magma', hue=x_labels, legend=False)\n",
    "ax[0].set_title(f'Distribuição de Probabilidade ($|\\Psi|^2$)\\n16 Estados de Superposição ({n_qubits} Qubits)', fontsize=14)\n",
    "ax[0].set_xlabel('Estado da Base (Binário)')\n",
    "ax[0].set_ylabel('Probabilidade')\n",
    "ax[0].tick_params(axis='x', rotation=45)\n",
    "\n",
    "# Heatmap: Matriz de Densidade (Parte Real)\n",
    "sns.heatmap(np.real(rho_16), ax=ax[1], cmap='viridis', annot=False, cbar_kws={'label': 'Re(ρ)'})\n",
    "ax[1].set_title('Matriz de Densidade (Componentes Reais)', fontsize=14)\n",
    "ax[1].set_xlabel('Índice da Base')\n",
    "ax[1].set_ylabel('Índice da Base')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 3. Renderização Numérica Matricial\n",
    "print(\"=\"*60)\n",
    "print(\"RENDERIZAÇÃO NUMÉRICA DOS 16 ESTADOS DE SUPERPOSIÇÃO\")\n",
    "print(\"=\"*60)\n",
    "print(f\"{'Índice':<8} | {'Base (b)':<10} | {'Amplitude Complexa':<35} | {'Probabilidade':<12}\")\n",
    "print(\"-\"*80)\n",
    "for i, (amp, prob) in enumerate(zip(psi_16, probabilities)):\n",
    "    print(f\"{i:<8} | {format(i, '04b'):<10} | {str(np.round(amp, 4)):<35} | {prob:.6f}\")\n"
