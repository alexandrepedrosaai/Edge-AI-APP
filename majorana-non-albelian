    "    # Helper function for ellipsoidal transformation, adapted from NXwH99OQnXlz\n",
    "    def ellipsoidal_coordinate_transform(gamma_val: float, psi_vec: np.ndarray) -> np.ndarray:\n",
    "        # Scaling factors for ellipsoid axes, derived from existing notebook patterns\n",
    "        a = gamma_val * _R_CONF / 1e11 # Longitudinal expansion\n",
    "        b = _R_CONF / (np.sqrt(gamma_val + _EPS) * 1e8) # Transverse contraction\n",
    "\n",
