    "import numpy as np\n",
    "import pandas as pd\n",
    "import json\n",
    "import hashlib\n",
    "import time\n",
    "from typing import List, Dict\n",
    "\n",
    "# --- Required Class Definitions ---\n",
    "class QuantumBlock:\n",
    "    def __init__(self, index: int, state_arrays: Dict, prev_hash: str):\n",
    "        self.index = index\n",
    "        self.timestamp = time.time()\n",
    "        self.state_arrays = state_arrays\n",
    "        self.prev_hash = prev_hash\n",
    "        self.data_str = self._serialize()\n",
    "        self.hash = self._compute_hash()\n",
    "\n",
    "    def _serialize(self) -> str:\n",
    "        return json.dumps({\n",
    "            \"index\": self.index,\n",
    "            \"timestamp\": self.timestamp,\n",
    "            \"state\": self.state_arrays,\n",
    "            \"prev_hash\": self.prev_hash\n",
    "        }, sort_keys=True)\n",
    "\n",
    "    def _compute_hash(self) -> str:\n",
    "        return hashlib.sha3_512(self.data_str.encode()).hexdigest()\n",
    "\n",
    "class QuantumBlockchain:\n",
    "    def __init__(self):\n",
    "        self.chain: List[QuantumBlock] = []\n",
    "        self._create_genesis()\n",
    "\n",
    "    def _create_genesis(self):\n",
    "        genesis_state = {\"amplitudes\": [1.0], \"phases\": [0.0]}\n",
    "        genesis = QuantumBlock(0, genesis_state, \"0\" * 128)\n",
    "        self.chain.append(genesis)\n",
    "\n",
    "    def add_state(self, psi: np.ndarray) -> str:\n",
    "        # Simplified conversion for simulation speed\n",
    "        arrays = {\"amplitudes\": np.abs(psi).tolist(), \"phases\": np.angle(psi).tolist()}\n",
    "        prev_hash = self.chain[-1].hash\n",
    "        new_block = QuantumBlock(len(self.chain), arrays, prev_hash)\n",
    "        self.chain.append(new_block)\n",
    "        return new_block.hash\n",
    "\n",
    "# --- Helper for Majorana State (Conceptual) ---\n",
    "def generate_psi(n_qubits=3):\n",
    "    dim = 2**n_qubits\n",
    "    psi = np.random.normal(size=(dim,)) + 1j * np.random.normal(size=(dim,))\n",
    "    return psi / np.linalg.norm(psi)\n",
    "\n",
    "# --- Execution ---\n",
    "qbc_expanded = QuantumBlockchain()\n",
    "iterations_large = 2048\n",
    "\n",
    "print(f\"🚀 Generating {iterations_large} blocks...\")\n",
    "for n in range(1, iterations_large + 1):\n",
    "    psi_val = generate_psi(3)\n",
    "    qbc_expanded.add_state(psi_val)\n",
    "    if n % 512 == 0:\n",
    "        print(f\"Block {n:04} committed...\")\n",
    "\n",
    "# Extract to DataFrame\n",
    "ledger_data_final = []\n",
    "for block in qbc_expanded.chain:\n",
    "    ledger_data_final.append({\n",
    "        'block_index': block.index,\n",
    "        'timestamp_ns': block.timestamp * 1e9,\n",
    "        'sha3_512_hash': block.hash,\n",
    "        'prev_hash': block.prev_hash\n",
    "    })\n",
    "\n",
    "df_ledger = pd.DataFrame(ledger_data_final)\n",
    "df_ledger.to_csv('complete_blockchain_ledger.csv', index=False)\n",
    "\n",
    "print(f\"\\n✅ Ledger exported to 'complete_blockchain_ledger.csv'. Total blocks: {len(df_ledger)}\")\n",
    "display(df_ledger.head())\n"
   ]
