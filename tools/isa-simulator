#!/usr/bin/env bash
# Placeholder ISA simulator validator – can be expanded with real simulation logic later.
set -euo pipefail

ARCH=""
INPUT=""
VALIDATE="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --arch)
      ARCH="$2"
      shift 2
      ;;
    --input)
      INPUT="$2"
      shift 2
      ;;
    --validate)
      VALIDATE="true"
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "${INPUT}" || ! -f "${INPUT}" ]]; then
  echo "Error: input file not found: '${INPUT}'" >&2
  exit 1
fi

if [[ "${VALIDATE}" == "true" ]]; then
  if [[ -n "${ARCH}" ]]; then
    echo "ISA validation passed for arch=${ARCH}, input=${INPUT}"
  else
    echo "ISA validation passed for: ${INPUT}"
  fi
fi
