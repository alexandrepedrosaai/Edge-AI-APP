<Project Sdk="Microsoft.Quantum.Sdk/0.28.302812">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>wave-space-dl</AssemblyName>
    <RootNamespace>WaveSpaceDL</RootNamespace>
    <!-- Disable automatic inclusion of files to prevent NETSDK1022 duplicate inclusion warnings -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Disable UI framework targets to prevent MSB4057 CreateManifestResourceNames error -->
    <UseWpf>false</UseWpf>
    <UseMaui>false</UseMaui>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- Force C# language targets for .qsproj so that CoreCompile and CreateManifestResourceNames are defined.
         Without this, .NET SDK 10+ falls back to Microsoft.Common.targets for non-.csproj extensions. -->
    <LanguageTargets>$(MSBuildToolsPath)\Microsoft.CSharp.targets</LanguageTargets>
  </PropertyGroup>

  <ItemGroup>
    <!-- wave-space-dl.qs and LLMNeuralDLQuantum.qs are auto-included by the Q# SDK's **/*.qs glob.
         Only explicitly include files outside the project directory to avoid duplicate QS7003 warnings. -->
    <QSharpCompile Include="..\ProceduralDLEncoder.qs" />
    <QSharpCompile Include="..\Program.qs" />
    <QSharpCompile Include="..\_version.qs" />
    <QSharpCompile Include="..\cli.qs" />
    <QSharpCompile Include="..\dataclass.qs" />
    <QSharpCompile Include="..\procedural_dl.qs" />
  </ItemGroup>

  <!-- Include other necessary files if they exist -->
  <ItemGroup>
    <None Include="**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


</Project>
