<Project Sdk="Microsoft.Quantum.Sdk/0.27.258156-beta">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>wave-space-dl</AssemblyName>
    <RootNamespace>WaveSpaceDL</RootNamespace>
  </PropertyGroup>

  <!-- 
    The Microsoft.Quantum.Sdk automatically includes Standard and Canon libraries. 
    Manual references are removed to prevent NU1102 and NU1504 errors.
  -->

  <ItemGroup>
    <QSharpCompile Include="..\ProceduralDLEncoder.qs" />
    <QSharpCompile Include="..\Program.qs" />
    <QSharpCompile Include="..\_version.qs" />
    <QSharpCompile Include="..\cli.qs" />
    <QSharpCompile Include="..\dataclass.qs" />
    <QSharpCompile Include="..\procedural_dl.qs" />
  </ItemGroup>

</Project>
