    <QSharpCompile Include="..\_version.qs" />
    <QSharpCompile Include="..\cli.qs" />
    <QSharpCompile Include="..\dataclass.qs" />
    <QSharpCompile Include="..\procedural_dl.qs" />
  </ItemGroup>

</Project>

