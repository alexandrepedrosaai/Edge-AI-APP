; src/firmware/stack_riscv.firmware
; Bytecode stack-based robusto (RISC-V VM-like)

        db 0x01,0x01   ; PUSH 1
        db 0x01,0x05   ; PUSH 5
        db 0x10        ; ADD
        db 0x01,0x02   ; PUSH 2
        db 0x20        ; MUL
        db 0x01,0x03   ; PUSH 3
        db 0x11        ; SUB
        db 0x30        ; PRINT
        db 0xFF        ; HALT
