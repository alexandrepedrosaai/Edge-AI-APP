// src/firmware/main_arm.firmware
// Firmware table em formato puro de bytes (ARM)

        .section .text
        .global _start
_start:
        .byte 0xE3,0xA0,0x00,0x01   // mov r0, #1
        .byte 0xE3,0xA0,0x10,0x05   // mov r1, #5
        .byte 0xE0,0x80,0x00,0x01   // add r0, r0, r1
        .byte 0xEF,0x00,0x00,0x01   // svc #1 (exit)
