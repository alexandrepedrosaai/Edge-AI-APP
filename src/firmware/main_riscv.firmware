# src/firmware/main_riscv.firmware
# Firmware table em formato puro de bytes (RISC-V)

        .section .text
        .globl _start
_start:
        .byte 0x13,0x05,0x00,0x01   # addi a0, zero, 1
        .byte 0x13,0x06,0x00,0x05   # addi a1, zero, 5
        .byte 0x33,0x85,0xA6,0x00   # add a0, a0, a1
        .byte 0x73,0x00,0x00,0x00   # ecall (exit)
