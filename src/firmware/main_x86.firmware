; src/firmware/main_x86.firmware
; Firmware table em formato puro de bytes (x86)

BITS 32
ORG 0x0000

; Instruções codificadas diretamente em ROM
db 0xB8, 0x01, 0x00, 0x00, 0x00   ; mov eax, 1
db 0xBB, 0x05, 0x00, 0x00, 0x00   ; mov ebx, 5
db 0x01, 0xD8                     ; add eax, ebx
db 0xCD, 0x80                     ; int 0x80 (Linux syscall exit)
