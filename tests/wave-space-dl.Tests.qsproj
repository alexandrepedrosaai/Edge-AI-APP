<Project Sdk="Microsoft.Quantum.Sdk/0.28.302812">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>wave-space-dl.Tests</AssemblyName>
    <RootNamespace>WaveSpaceDL.Tests</RootNamespace>
    <!-- Disable automatic inclusion of files to prevent NETSDK1022 duplicate inclusion warnings -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Force C# language targets for .qsproj so that CoreCompile and CreateManifestResourceNames are defined. -->
    <LanguageTargets>$(MSBuildToolsPath)\Microsoft.CSharp.targets</LanguageTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Quantum.Xunit" Version="0.28.302812" />
  </ItemGroup>

  <ItemGroup>
    <!-- Directly include source Q# files so the Q# compiler sees WaveSpaceDL symbols. -->
    <QSharpCompile Include="..\src\wave-space-dl.qs" />
    <QSharpCompile Include="..\src\LLMNeuralDLQuantum.qs" />
  </ItemGroup>

</Project>
